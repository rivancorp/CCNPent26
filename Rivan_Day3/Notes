===== OSPF Neighbor Adjacency =====
Unique router-id
Same area ID
Same Network/Subnet mask on the area
Same Auth type
Same Network type
Same Timers
Stub Area
Designated Router and Designated Backup Router



===== OSPF Metric Calculation =====
Cost = Reference BW / Interface BW


Adjus Reference bandwidth
!@R4
conf t
 router ospf 1
  auto-cost reference-bandwidth 100000
end


===== OSPF to EIGRP Redistribution =====
SEED Metrics
1. OSPF -> 20
2. EIGRP -> Infinity
3. RIP -> Infinity
4. BGP -> IGP
5. IS-IS -> 0

!@GoogleDNS
config t
 interface Loopback1
  ip address 51.51.51.51 255.255.255.255
 interface Loopback2
  ip address 52.52.52.52 255.255.255.255
 interface Loopback3
  ip address 53.53.53.53 255.255.255.255
 interface Loopback4
  ip address 54.54.54.54 255.255.255.255
 router bgp 25
  network 51.51.51.51 mask 255.255.255.255
  network 52.52.52.52 mask 255.255.255.255
  network 53.53.53.53 mask 255.255.255.255
  network 54.54.54.54 mask 255.255.255.255
  end


  !@R1
conf t
  access-list 51 permit host 51.51.51.51
  access-list 53 permit host 53.53.53.53
   route-map ISPfor51 permit 10
   match ip address 51
   set weight 51
  route-map ISPfor51 permit 20
  route-map ISPfor53 permit 10
   match ip address 53
   set weight 53
  route-map ISPfor51 permit 20
end
conf t

 router bgp 1
  neighbor 208.8.8.4 route-map ISPfor51 in
  neighbor 209.9.9.3 route-map ISPfor53 in
end
clear ip bgp * soft



